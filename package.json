{
  "name": "mcp-server-cookbook-root",
  "private": true,
  "version": "0.0.1",
  "description": "Root-level tooling for mcp-server-cookbook. Each server under servers/ is its own Node project; this package.json exists only to hold dev-only dependencies that the tools/ scripts use (notably the workflow YAML parseability lock \u2014 issue #46).",
  "type": "module",
  "scripts": {
    "check:boot-config-guard": "node tools/check-boot-config-guard.mjs",
    "test:boot-config-guard": "node --test tools/check-boot-config-guard.test.mjs",
    "check:workflow-yaml": "node tools/check-workflow-yaml.mjs",
    "test:workflow-yaml": "node --test tools/check-workflow-yaml.test.mjs",
    "check:workflow-timeout": "node tools/check-workflow-timeout.mjs",
    "test:workflow-timeout": "node --test tools/check-workflow-timeout.test.mjs",
    "check:workflow-concurrency": "node tools/check-workflow-concurrency.mjs",
    "test:workflow-concurrency": "node --test tools/check-workflow-concurrency.test.mjs",
    "check:numeric-env-grammar": "node tools/check-numeric-env-grammar.mjs",
    "test:numeric-env-grammar": "node --test tools/check-numeric-env-grammar.test.mjs",
    "check:string-env-grammar": "node tools/check-string-env-grammar.mjs",
    "test:string-env-grammar": "node --test tools/check-string-env-grammar.test.mjs",
    "check:config-port-parity": "node tools/check-config-port-parity.mjs",
    "test:config-port-parity": "node --test tools/check-config-port-parity.test.mjs",
    "check:env-example": "node tools/check-env-example.mjs",
    "test:env-example": "node --test tools/check-env-example.test.mjs",
    "test:strip-comments": "node --test tools/lib/strip-comments.test.mjs",
    "test:tools-files": "node --test tools/lib/tools-files.test.mjs",
    "test:tools-test-registration": "node --test tools/check-tools-test-registration.test.mjs"
  },
  "devDependencies": {
    "yaml": "^2.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
