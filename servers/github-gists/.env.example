# Copy to .env (gitignored) and fill in. Nothing loads it automatically:
#   set -a; . ./.env; set +a

# Optional for public gists, required to update one you own (e.g. ghp_...).
# Never echoed: errors and logs redact it (D-007). Ships blank: any non-blank
# value is sent as a token, so a placeholder here turned every public read
# into 401 once the file was loaded (#221).
GITHUB_TOKEN=

# Optional. API base URL; must start with http:// or https://.
# Default https://api.github.com.
MCP_GITHUB_GISTS_BASE_URL=https://api.github.com

# Optional. User-Agent header. Default mcp-cookbook-github-gists/0.1.0.
MCP_GITHUB_GISTS_USER_AGENT=mcp-cookbook-github-gists/0.1.0

# Optional. Per-request timeout in ms. Default 10000.
MCP_GITHUB_GISTS_TIMEOUT_MS=10000
