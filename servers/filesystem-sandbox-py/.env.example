# Copy to .env (gitignored) and fill in. Nothing loads it automatically:
#   set -a; . ./.env; set +a
# The TypeScript and Python ports read the same three settings.

# Required. Colon-separated absolute paths the server may touch. Every root
# must exist at boot, so create them first (mkdir -p /tmp/scratch).
MCP_FS_SANDBOX_ALLOWLIST=/tmp/scratch

# Optional. Per-call read/write byte cap. Default 1000000.
MCP_FS_SANDBOX_MAX_BYTES=1000000

# Optional. 1 / true / yes (any case) refuses write_file. Default off.
MCP_FS_SANDBOX_READ_ONLY=0
